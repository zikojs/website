{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist",  "node_modules/zextra"],
  "compilerOptions": {
    "paths": {
      "@components/*": ["./src/components/*"],
      "@/assets/*": ["./src/assets/*"],  
      "@/layouts/*": ["./src/layouts/*"],
      "@/i18n/*": ["./src/i18n/*"]
    }
  }
}
